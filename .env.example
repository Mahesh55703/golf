# Google Gemini API key
GEMINI_API_KEY=replace_with_your_google_gemini_api_key

# Neon PostgreSQL Database Connection URL (from Neon Console)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Admin JWT Authentication Secret Key (Generate a random 32+ char string in production)
ADMIN_JWT_SECRET="golfpulse-super-secret-key-change-in-production-2026-secure"

# Optional Cloud Storage (Vercel Blob / S3)
# If omitted, media uploaded via the admin manager automatically saves to local public storage
BLOB_READ_WRITE_TOKEN=""

# Razorpay Payment Gateway Configuration (Phase 3.7)
# Public key exposed only to checkout frontend
RAZORPAY_KEY_ID="rzp_test_replace_with_your_key_id"
# Secret key retained strictly on server
RAZORPAY_KEY_SECRET="replace_with_your_razorpay_secret"
# Secret for validating HMAC-SHA256 webhook signatures
RAZORPAY_WEBHOOK_SECRET="replace_with_your_webhook_secret"
# Optional: Explicit development payment simulation (STRICTLY non-production only)
# In production (NODE_ENV=production), simulation is completely rejected regardless of this setting
ENABLE_PAYMENT_SIMULATION="false"

# Transactional Email Dispatcher (Resend REST API - Phase 4.1)
# Sign up at https://resend.com for 3,000 free emails/month. If omitted, inquiries are logged in mock mode.
RESEND_API_KEY=""
CONTACT_EMAIL_TO="tournaments@golfpulse.com"
CONTACT_EMAIL_FROM="GolfPulse Inquiries <onboarding@resend.dev>"
